{
  manifest_version: "0.1.0",
  program: {
    image: "python:3.12-slim",
    entrypoint: "sh -lc \"pip install --quiet --no-cache-dir 'a2a-sdk[http-server]==0.3.20' 'uvicorn==0.35.0' >/tmp/pip.log && python -c 'import base64, os, pathlib; pathlib.Path(\\\"/tmp/server.py\\\").write_bytes(base64.b64decode(os.environ[\\\"AGENT_SERVER_B64\\\"]))' && python /tmp/server.py --host 0.0.0.0 --port 9010\"",
    env: {
      AGENT_SERVER_B64: "",
      API_KEY: "${config.api_key}",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9010 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {
      api_key: { type: "string", secret: true },
    },
    required: ["api_key"],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
}
