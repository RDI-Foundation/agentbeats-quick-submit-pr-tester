{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/rdi-foundation/agentbeats-quick-submit-pr-tester-mock-purple:latest",
    entrypoint: "python /app/server.py --host 0.0.0.0 --port 9010",
    env: {
      API_KEY: "${config.api_key}",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9010 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {
      api_key: { type: "string", secret: true },
    },
    required: ["api_key"],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
}
