{
  manifest_version: "0.1.0",
  program: {
    image: "python:3.12-slim",
    entrypoint: "sh -lc \"pip install --quiet --no-cache-dir 'a2a-sdk[http-server]==0.3.20' 'httpx==0.28.1' 'uvicorn==0.35.0' >/tmp/pip.log && python -c 'import base64, os, pathlib; pathlib.Path(\\\"/tmp/server.py\\\").write_bytes(base64.b64decode(os.environ[\\\"AGENT_SERVER_B64\\\"]))' && python /tmp/server.py --host 0.0.0.0 --port 9009\"",
    env: {
      AGENT_SERVER_B64: "",
      PROXY_URL: "${slots.proxy.url}",
      GREEN_TOKEN: "${config.green_token}",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9009 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {
      green_token: { type: "string", secret: true },
    },
    required: ["green_token"],
    additionalProperties: false,
  },
  slots: {
    proxy: { kind: "a2a" },
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
  metadata: {
    assessment_config: { runs: 1 },
    participant_roles: ["competitor"],
  },
}
