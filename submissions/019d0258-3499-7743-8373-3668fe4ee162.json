{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "competitor_api_key": {
        "type": "string",
        "secret": true
      },
      "green_green_token": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_green_token",
      "competitor_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.3/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "runs": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "competitor"
        },
        "callback_urls": {}
      }
    },
    "green": {
      "manifest": "https://visibility-compression-influence-bid.trycloudflare.com/mock-green.json5",
      "config": {
        "green_token": "${config.green_green_token}"
      }
    },
    "competitor": {
      "manifest": "https://visibility-compression-influence-bid.trycloudflare.com/mock-purple.json5",
      "config": {
        "api_key": "${config.competitor_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#competitor.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019d0258-2274-7fc2-97a8-6b8203e994c7",
      "competitor": "019d0258-23bf-7601-947b-0f26ecd28ca3"
    }
  }
}