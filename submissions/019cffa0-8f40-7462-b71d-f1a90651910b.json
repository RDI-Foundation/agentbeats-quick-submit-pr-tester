{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "competitor_api_key": {
        "type": "string",
        "secret": true
      },
      "green_green_token": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_green_token",
      "competitor_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "runs": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "competitor"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-quick-submit-pr-tester/main/manifests/mock-green.json5?token=B5PZKCD2CJ6KLMLWMDO4UMDJXJDABAVPNFXHG5DBNRWGC5DJN5XF62LEZYDHNIDIWFUW443UMFWGYYLUNFXW4X3UPFYGLN2JNZ2GKZ3SMF2GS33OJFXHG5DBNRWGC5DJN5XA",
      "config": {
        "green_token": "${config.green_green_token}"
      }
    },
    "competitor": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-quick-submit-pr-tester/main/manifests/mock-purple.json5?token=B5PZKCCRFXE2F2V4CUJYWYTJXJDADAVPNFXHG5DBNRWGC5DJN5XF62LEZYDHNIDIWFUW443UMFWGYYLUNFXW4X3UPFYGLN2JNZ2GKZ3SMF2GS33OJFXHG5DBNRWGC5DJN5XA",
      "config": {
        "api_key": "${config.competitor_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#competitor.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019cffa0-8acb-7642-9df3-eee511c70061",
      "competitor": "019cffa0-8b0c-7d10-bfe0-55170ac48056"
    }
  }
}