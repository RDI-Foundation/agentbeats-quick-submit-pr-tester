{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "competitor_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "green_google_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_google_api_key",
      "competitor_openai_api_key"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "runs": 1
        },
        "participant_roles": {
          "green": "green",
          "purple1": "competitor"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/heads/main/examples/debate/debate-judge.json5",
      "config": {
        "google_api_key": "${config.green_google_api_key}"
      }
    },
    "competitor": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/heads/main/examples/debate/debater.json5",
      "config": {
        "openai_api_key": "${config.competitor_openai_api_key}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#competitor.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019cf9d8-8ebe-76a3-a817-6143eef8e702",
      "competitor": "019cf9d8-8ee0-7c13-b378-b2ac0ff4d5ca"
    }
  }
}