    "competitor": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-quick-submit-pr-tester/main/manifests/mock-purple.json5?token=B5PZKCANGXGVWOG73ZGNK3TJXJQOHAVPNFXHG5DBNRWGC5DJN5XF62LEZYDHNIDIWFUW443UMFWGYYLUNFXW4X3UPFYGLN2JNZ2GKZ3SMF2GS33OJFXHG5DBNRWGC5DJN5XA",
