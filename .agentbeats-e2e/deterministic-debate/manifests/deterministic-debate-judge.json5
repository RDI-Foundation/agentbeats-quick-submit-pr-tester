{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/rdi-foundation/agentbeats-tutorial-debate-judge:latest",
    entrypoint: "sh -lc 'python -c \"import pathlib, urllib.request; pathlib.Path(\\\"/tmp/deterministic_debate_judge.py\\\").write_text(urllib.request.urlopen(\\\"https://raw.githubusercontent.com/RDI-Foundation/agentbeats-quick-submit-pr-tester/agentbeats-e2e-quick-submit-5d60ed0541/.agentbeats-e2e/deterministic-debate/scripts/deterministic_debate_judge.py\\\").read().decode())\" && exec uv run --no-sync python /tmp/deterministic_debate_judge.py --host 0.0.0.0 --port 9009'",
    env: {
      PROXY_URL: "${slots.proxy.url}",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9009 },
      ],
    },
  },
  config_schema: {
    type: "object",
    properties: {},
    required: [],
    additionalProperties: false,
  },
  slots: {
    proxy: { kind: "a2a" },
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" },
  },
  exports: {
    a2a: "a2a",
  },
  metadata: {
    assessment_config: { num_rounds: 2, topic: "AI should be regulated." },
    participant_roles: ["pro_debater", "con_debater"],
  },
}
